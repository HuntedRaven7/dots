# Containerfile.ai
# llama.cpp with CUDA GPU support in an NVIDIA container.
# Persistent model storage at /opt/models survives container recreates.
#
# Build:
#   podman build --build-arg NVIDIA_VISIBLE_DEVICES=all -f containers/Containerfile.ai -t llama-cuda .
#   docker build --build-arg NVIDIA_VISIBLE_DEVICES=all -f containers/Containerfile.ai -t llama-cuda .
#
# Run (GPU passthrough):
#   podman run --gpus all -v llama-models:/opt/models -p 8080:8080 llama-cuda
#   docker run --gpus all -v llama-models:/opt/models -p 8080:8080 llama-cuda
#
# Run (without GPU):
#   podman run -v llama-models:/opt/models -p 8080:8080 llama-cuda

ARG CUDA_VERSION=12.9.1
ARG UBUNTU_VERSION=24.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive

# ---------- System dependencies ----------
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates curl python3 python3-dev python3-venv \
        git build-essential cmake \
        libatomic1 procps jq htop && \
    rm -rf /var/lib/apt/lists/*

# ---------- CUDA environment ----------
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- llama.cpp binary install ----------
# The llama.app installer auto-detects CUDA and downloads the correct
# pre-built binary from Hugging Face.  It installs to ~/.local/bin/llama.
ENV HOME=/opt/data
ENV SKIP_ROCM=1
ENV SKIP_VULKAN=1
RUN mkdir -p /opt/data && \
    curl -LsSf https://llama.app/install.sh | bash

# The installer puts the binary at /opt/data/.local/bin/llama.
# Symlink to a standard location so it's on PATH.
ENV PATH="/opt/data/.local/bin:${PATH}"

# ---------- Non-root user ----------
RUN useradd -u 10000 -m -d /opt/data hermes && \
    chown -R hermes:hermes /opt/data

# ---------- Persistent directories ----------
# /opt/data/.llama-app/  — llama runtime / cache
# /opt/models/           — GGUF model files (mount a large volume here)
VOLUME [ "/opt/models", "/opt/data" ]

WORKDIR /opt/models

# Default: start the llama-server on all interfaces
EXPOSE 8080
ENTRYPOINT [ "llama", "serve" ]
CMD [ "--host", "0.0.0.0", "--port", "8080" ]
