# hermes.env.example
# Copy to hermes.env and fill in your API keys.
# Pass to the container via: --env-file hermes.env

# ---------- Model provider (pick one or more) ----------
# Hermes Portal (covers model + tools in one subscription):
# HERMES_PORTAL_KEY=

# OpenRouter:
# OPENROUTER_API_KEY=

# OpenAI:
# OPENAI_API_KEY=

# Anthropic:
# ANTHROPIC_API_KEY=

# ---------- Tool keys (optional, also available via Portal Tool Gateway) ----------
# Web search (Firecrawl):
# FIRECRAWL_API_KEY=

# Image generation (FAL):
# FAL_KEY=

# TTS (OpenAI):
# OPENAI_TTS_KEY=

# Cloud browser (Browser Use):
# BROWSER_USE_KEY=

# ---------- NVIDIA GPU ----------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- Local LLM (llama.cpp) ----------
# Base URL for the llama.cpp server running in containers/ai/
# If both stacks use host networking, use the host loopback address.
# LLAMA_BASE_URL=http://127.0.0.1:8080

# ---------- User remapping ----------
# Set to your host UID/GID so files created inside the container are owned
# by your user on the host (avoids root-owned artifacts in bind mounts).
# HERMES_UID=1000
# HERMES_GID=1000
