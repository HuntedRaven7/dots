# Containerfile.hermes
# Hermes Agent with CUDA GPU support in an NVIDIA container.
# Persistent storage at /opt/data survives container recreates.
#
# Build:
#   podman build --build-arg NVIDIA_VISIBLE_DEVICES=all -f containers/Containerfile.hermes -t hermes-cuda .
#   docker build --build-arg NVIDIA_VISIBLE_DEVICES=all -f containers/Containerfile.hermes -t hermes-cuda .
#
# Run (GPU passthrough):
#   podman run --gpus all -v hermes-data:/opt/data --env-file hermes.env -it hermes-cuda
#   docker run --gpus all -v hermes-data:/opt/data --env-file hermes.env -it hermes-cuda
#
# Run (without GPU):
#   podman run -v hermes-data:/opt/data --env-file hermes.env -it hermes-cuda

# CUDA base image (update via Renovate by bumping the tag below):
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive

# ---------- System dependencies ----------
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates curl iputils-ping python3 python-is-python3 \
        ripgrep ffmpeg gcc g++ make cmake python3-dev python3-venv \
        libffi-dev libatomic1 procps git openssh-client xz-utils \
        nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# ---------- Non-root user ----------
RUN useradd -u 10000 -m -d /opt/data hermes

# ---------- Hermes install ----------
# Run the official installer in a non-interactive, no-setup mode.
# The installer provisions uv, Python 3.11, Node.js, and the hermes CLI
# under /opt/hermes (the FHS root layout).  We skip the interactive
# setup wizard (--skip-setup) and the Playwright browser install
# (--skip-browser) to keep the image lean; API keys go in hermes.env
# or are passed at runtime.
ENV HOME=/opt/data
ENV HERMES_HOME=/opt/data
RUN curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- \
        --skip-setup --skip-browser --no-venv --dir /opt/hermes

# ---------- CUDA-aware Python path fixup ----------
# The uv-managed Python 3.11 is installed under /opt/hermes.  Make sure the
# venv's site-packages can find CUDA libs the driver exposes at runtime.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- Persistent state & runtime config ----------
ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data
ENV HERMES_DISABLE_LAZY_INSTALLS=1
ENV HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"

# ---------- Persistent volumes ----------
# /opt/data holds all durable state:
#   - MEMORY.md, USER.md   (agent memory / user model)
#   - config.yaml           (provider keys, preferences)
#   - sessions/             (conversation history + FTS5 search index)
#   - skills/               (auto-generated + user skills)
#   - lazy-packages/        (runtime pip installs survive rebuilds)
#   - state.db              (cron jobs, schedule state)
#
# Mount a named volume or bind-mount a host directory here to persist
# learning across container recreates and image updates.
VOLUME [ "/opt/data" ]

WORKDIR /opt/hermes

ENTRYPOINT [ "hermes" ]
CMD []
